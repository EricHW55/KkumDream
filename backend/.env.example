APP_NAME=KKUMDREAM
ENVIRONMENT=local
API_V1_PREFIX=/api/v1

# PostgreSQL/Supabase connection.
# Use postgresql+asyncpg:// for the FastAPI app.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kkumdream

# Local development only. Set to a fixed UUID to bypass bearer auth.
AUTH_MOCK_USER_ID=00000000-0000-0000-0000-000000000001
SUPABASE_JWT_SECRET=

# AI
AI_MOCK_MODE=true
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
REPLICATE_API_TOKEN=
REPLICATE_FLUX_MODEL=black-forest-labs/flux-schnell

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=https://img.kkumdream.app

# Firebase Cloud Messaging
FIREBASE_CREDENTIALS_JSON=

