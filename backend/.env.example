APP_NAME=KKUMDREAM
ENVIRONMENT=local
API_V1_PREFIX=/api/v1

# PostgreSQL/Supabase connection.
# Use postgresql+asyncpg:// for the FastAPI app.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kkumdream

# Local development only. Set to a fixed UUID to bypass bearer auth.
AUTH_MOCK_USER_ID=00000000-0000-0000-0000-000000000001
SUPABASE_JWT_SECRET=
APP_JWT_SECRET=replace-with-a-long-random-secret
APP_JWT_EXPIRE_DAYS=30
GOOGLE_WEB_CLIENT_ID=
ADMIN_API_TOKEN=replace-with-a-long-random-admin-token

# AI
AI_MOCK_MODE=true
ANTHROPIC_API_KEY=
ANTHROPIC_TEXT_MODEL=claude-haiku-4-5
OPENAI_API_KEY=
REPLICATE_API_TOKEN=
REPLICATE_FLUX_MODEL=black-forest-labs/flux-schnell

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=https://img.kkumdream.app

# Firebase Cloud Messaging
FIREBASE_CREDENTIALS_JSON=

# Google Play billing (subscription verification + RTDN)
# Prod: paste the kkumdream-play-api key JSON here (set as a fly secret).
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Local dev alternative: path to the key file instead of inlining JSON.
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=../secrets/google-play-service-account.json
GOOGLE_PLAY_PRODUCT_ID=kkumdream_pass_monthly
IOS_PRODUCT_ID=kkumdream_pass_monthly_ios
# Set after the RTDN push subscription is created (OIDC verification).
GOOGLE_PLAY_RTDN_AUDIENCE=
GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY=

# Share/deep link fallback
SHARE_BASE_URL=https://kkumdream.app
SHARE_TOKEN_DEFAULT_EXPIRE_DAYS=30
ANDROID_PACKAGE_NAME=com.kkumdreammobile
IOS_BUNDLE_ID=com.kkumdreammobile
ANDROID_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.kkumdreammobile
ANDROID_APP_LINK_SHA256_FINGERPRINTS=[]
IOS_APP_STORE_URL=https://apps.apple.com/app/kkumdream
IOS_APP_ID=
